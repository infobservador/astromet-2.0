# Copiá este archivo como ".env.local" (sin ".example") y completá tus claves reales.
# IMPORTANTE: "OPENWEATHER_KEY" es SOLO para el servidor (rutas /api/*), sin prefijo NEXT_PUBLIC_.
# Así la key nunca queda visible en el navegador del usuario.

OPENWEATHER_KEY=tu_api_key_de_openweather

# Contaminación lumínica con datos satelitales REALES (World Atlas 2015 / NASA-NOAA VIIRS),
# vía lightpollutionmap.info. Es OPCIONAL: si no la completás, la app sigue funcionando
# con una estimación aproximada según el tipo de lugar (ciudad/pueblo/zona rural/área
# protegida), sin necesitar esta clave.
#
# Cómo conseguirla (gratis, 500 consultas/día): escribile a Jurij Stare, el mantenedor
# del sitio, a starej@t-2.net, contándole que es para una app de astroturismo y que
# necesitás acceso al endpoint QueryRaster (capa "wa_2015"). Es un trámite manual por
# mail, no hay un formulario de alta automática.
LIGHTPOLLUTION_KEY=tu_clave_de_lightpollutionmap_info

# Descripción de la noche generada con IA (Claude, de Anthropic). Es OPCIONAL: si no
# la completás, la app sigue funcionando con el generador local por reglas (gratis,
# sin IA). Se obtiene en console.anthropic.com → API Keys → Create Key (autoservicio,
# con tarjeta cargada; el costo es muy bajo, centavos por consulta con Haiku 4.5).
ANTHROPIC_API_KEY=tu_clave_de_anthropic

# Sistema de créditos por operador (Fase 1). OPCIONAL: si no configurás esto, la app
# sigue funcionando exactamente igual que antes (sin sistema de créditos).
#
# UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN: se generan solas al conectar una
# base de datos de Upstash desde Vercel (Dashboard del proyecto → Storage → Create
# Database → Upstash → Redis → Connect). No hace falta copiarlas a mano normalmente,
# Vercel las agrega automáticamente a las variables de entorno del proyecto.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clave para entrar al panel de administración en /admin (elegís vos cualquier clave,
# no tiene que venir de ningún servicio externo). Guardala en un lugar seguro.
ADMIN_SECRET=elegi_una_clave_larga_y_dificil_de_adivinar
