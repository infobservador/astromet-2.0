# Copiá este archivo como ".env.local" (sin ".example") y completá tus claves reales.
# IMPORTANTE: "OPENWEATHER_KEY" es SOLO para el servidor (rutas /api/*), sin prefijo NEXT_PUBLIC_.
# Así la key nunca queda visible en el navegador del usuario.

OPENWEATHER_KEY=tu_api_key_de_openweather

# Opcional / futuro: para el cálculo de contaminación lumínica (Bortle).
# Mientras no tengas un servicio real conectado, esta función va a devolver "No disponible"
# de forma controlada (no rompe la app).
NASA_TOKEN=tu_token_de_nasa_earthdata
